# Copy this file to scripts/registry.env and fill in your real values.
# scripts/registry.env is matched by the repo's *.env gitignore rule, so it
# will never be committed. NEVER put real secrets in this .example file.

# --- Nexus (scripts/nexus-upload.sh) ---
NEXUS_URL=http://nexus.wibu.local
NEXUS_REPO=terraform-providers
NEXUS_USER=
NEXUS_PASSWORD=

# --- Terrakube (scripts/terrakube-register-provider.sh) ---
TERRAKUBE_API_URL=https://terrakube-api.k8s.wibu.local
TERRAKUBE_TOKEN=
ORG_ID=
GPG_KEY_ID=

# --- Shared ---
VERSION=7.0.0-SNAPSHOT-2e1dff4c
DOWNLOAD_BASE_URL=http://nexus.wibu.local/repository/terraform-providers/rancher2/7.0.0-SNAPSHOT-2e1dff4c
